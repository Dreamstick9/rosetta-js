new file mode 100644
index 0000000..a40bc2d
--- /dev/null
+++ b/tinydb/errors.py
@@ -0,0 +1,26 @@
+"""
+Exceptions raised by TinyDB.
+"""
+
+__all__ = ('TinyDBError', 'UniqueConstraintError')
+
+
+class TinyDBError(Exception):
+    """
+    Base class for all TinyDB errors.
+    """
+
+
+class UniqueConstraintError(TinyDBError):
+    """
+    Raised when a write would store a duplicate value in a unique field.
+    """
+
+    def __init__(self, table: str, field: str, value) -> None:
+        super().__init__(
+            f'Duplicate value {value!r} for unique field {field!r} '
+            f'in table {table!r}'
+        )
+        self.table = table
+        self.field = field
+        self.value = value
