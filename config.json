{
  "baseUrl": "https://ai.hackclub.com/proxy/v1",
  "model": "deepseek/deepseek-v4.1-flash",
  "maxContextTokens": 64000,
  "maxOutputTokens": 8192,
  "temperature": 0.2,
  "topP": 1,
  "seed": 7,
  "maxTurns": 60,
  "maxSessionUsd": 1,
  "policy": "standard",
  "exitAfterTask": true,
  "pricing": {
    "inputPerMTok": 0.035,
    "cachedInputPerMTok": 0.001,
    "outputPerMTok": 0.29
  },
  "context": {
    "maxToolOutputBytes": 16000,
    "compactStartShare": 0.7,
    "compactTargetShare": 0.35,
    "keptToolResults": 4
  },
  "agent": {
    "maxEmptyReplyNudges": 2,
    "maxCheckRounds": 2,
    "failureTailLines": 60
  },
  "timeouts": {
    "commandSeconds": 120,
    "testCheckSeconds": 180,
    "streamStallSeconds": 60
  },
  "retries": {
    "maxRetries": 3,
    "maxStallRetries": 1,
    "baseBackoffMs": 1000,
    "maxRetryAfterMs": 60000
  },
  "tools": {
    "maxSearchMatches": 100,
    "maxSearchLineLength": 200,
    "listDepth": 2,
    "readLineLimit": 2000
  },
  "skills": {
    "maxInstructionTokens": 4000,
    "maxCatalogSkills": 40,
    "maxDescriptionChars": 150,
    "maxSkillFiles": 50,
    "internal": false,
    "maxAuto": 2,
    "detect": false
  },
  "intake": {
    "maxComments": 20,
    "maxBodyChars": 8000,
    "maxCommentChars": 2000,
    "cloneDepth": 1,
    "apiTimeoutSeconds": 20,
    "gitTimeoutSeconds": 180
  },
  "agents": {
    "maxParallelAgents": 3,
    "explorerMaxTurns": 15,
    "workerMaxTurns": 40,
    "reviewerMaxTurns": 10,
    "explorerMaxUsd": 0.05,
    "workerMaxUsd": 0.2,
    "reviewerMaxUsd": 0.05,
    "reviewerEnabled": false,
    "fanOutMinItems": 2,
    "fanOutMinFiles": 4,
    "autoTournament": true,
    "tournamentSize": 2
  },
  "digest": {
    "enabled": true,
    "minLines": 60
  }
}
